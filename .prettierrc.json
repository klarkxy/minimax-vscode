{
  "useTabs": true,
  "tabWidth": 2,
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.md",
      "options": { "proseWrap": "preserve" }
    },
    {
      "files": "*.jsonl",
      "options": { "printWidth": 1000 }
    },
    {
      "files": ["*.json", "*.jsonc"],
      "options": { "useTabs": false, "tabWidth": 2 }
    }
  ]
}

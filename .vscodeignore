.vscode/**
.vscode-test/**
plans/**
src/**
node_modules/**
tsconfig.json
esbuild.mjs
esbuild.tests.mjs
package-lock.json
**/*.map

# GitHub-side: the marketplace README is rewritten to dist/README.marketplace.md
# by .github/scripts/prepare-marketplace-readme.mjs and passed to vsce via
# --readme-path, so neither the source README files nor the .github tooling
# should end up inside the VSIX. The LICENSE file is left in so vsce can
# pick it up and ship it as LICENSE.txt (a hard Marketplace requirement).
.github/**
README.md
README.zh.md
CHANGELOG.md
CHANGELOG.zh.md
LICENSE_zh
.gitignore
TODO.md
CLAUDE.md
.learnings/**

# Reference / scratch directories that must not be shipped
deepseek-v4-for-copilot/**
minimax-status/**
Mini-Agent/**
oai-compatible-copilot/**
docs/**
test/**

# Local Claude Code memory — must not ship in the VSIX.
# Previous builds silently bundled .claude/memory/*.md because the path
# was not denied. Working-tree files, not part of the extension.
.claude/**

# Local build artefacts
dist/**
out-test/**
**/*.vsix

# Windows reserved device names — the Marketplace validator rejects VSIX
# entries whose name is a reserved device (nul/con/prn/aux/com1-9/lpt1-9)
# as "unsafe for extraction", regardless of the build host's OS. This bites
# when a Windows user accidentally creates e.g. `>nul` and the file lands in
# the working tree. Catch them at the root with a leading-segment match.
/nul
/con
/prn
/aux
/com[1-9]
/lpt[1-9]

# Bundle the SKILL files that ship with the extension (consumed at
# runtime by the dashboard's "Install Agent Skill" fallback). They
# live outside `src/` and are not in the deny list above, but we
# whitelist them explicitly here so future edits to this file can't
# accidentally drop them.
!skills/**

.vscode/**
.vscode-test/**
plans/**
src/**
node_modules/**
tsconfig.json
esbuild.mjs
esbuild.tests.mjs
package-lock.json
**/*.map

# GitHub-side: the marketplace README is rewritten to dist/README.marketplace.md
# by .github/scripts/prepare-marketplace-readme.mjs and passed to vsce via
# --readme-path, so neither the source README files nor the .github tooling
# should end up inside the VSIX. The LICENSE file is left in so vsce can
# pick it up and ship it as LICENSE.txt (a hard Marketplace requirement).
.github/**
README.md
README.zh.md
CHANGELOG.md
CHANGELOG.zh.md
LICENSE_zh
.gitignore
TODO.md
CLAUDE.md
.learnings/**

# Reference / scratch directories that must not be shipped
deepseek-v4-for-copilot/**
minimax-status/**
Mini-Agent/**
oai-compatible-copilot/**
docs/**
image/**
test/**

# Local Claude Code memory — must not ship in the VSIX.
# Previous builds silently bundled .claude/memory/*.md because the path
# was not denied. Working-tree files, not part of the extension.
.claude/**

# Local build artefacts
dist/**
out-test/**
coverage/**
**/*.vsix

# codegraph knowledge graph — local SQLite index, must not ship.
# Mirrored from .gitignore because vsce only consults .vscodeignore.
.codegraph/**

# Stray scratch / test logs from ad-hoc `> foo.log` runs. `.gitignore`
# already denies `*.log`, but `vsce package` only consults `.vscodeignore`
# — so we have to mirror the deny here, otherwise a 23 KB `test-all.log`
# silently ships as `extension/test-all.log` in the VSIX (this is how
# `v2.4.0` was almost published with the full unit-test transcript
# inside). Catch `*.log` everywhere, including any future sub-directory.
**/*.log

# Windows reserved device names — the Marketplace validator rejects VSIX
# entries whose name is a reserved device (nul/con/prn/aux/com1-9/lpt1-9)
# as "unsafe for extraction", regardless of the build host's OS. This bites
# when a Windows user accidentally creates e.g. `>nul` and the file lands in
# the working tree. Catch them at the root with a leading-segment match.
/nul
/con
/prn
/aux
/com[1-9]
/lpt[1-9]

# Vendored upstream VS Code source kept at the repo root as reference
# while authoring the picker context-size column tests (see
# `test/pickerContextSize.test.ts` for the upstream rendering rule
# these files document). `vsce package` does not strip root-level
# `.ts` files that nothing imports, so the 73 KB vendored copy of
# `microsoft/vscode/.../chatModelsWidget.ts` was being shipped as
# `extension/chatModelsWidget.ts` in the published VSIX. Deny
# both files at the root so a future contributor who drops another
# vendored reference at the root must update this rule on purpose.
chatModelsWidget.ts
numbers.ts

# Bundle the SKILL files that ship with the extension (consumed at
# runtime by the dashboard's "Install Agent Skill" fallback). They
# live outside `src/` and are not in the deny list above, but we
# whitelist them explicitly here so future edits to this file can't
# accidentally drop them.
!skills/**

.vscode/**
.vscode-test/**
plans/**
src/**
node_modules/**
tsconfig.json
esbuild.mjs
esbuild.tests.mjs
package-lock.json
**/*.map

# GitHub-side: the marketplace README is rewritten to dist/README.marketplace.md
# by .github/scripts/prepare-marketplace-readme.mjs and passed to vsce via
# --readme-path, so neither the source README files nor the .github tooling
# should end up inside the VSIX. The LICENSE file is left in so vsce can
# pick it up and ship it as LICENSE.txt (a hard Marketplace requirement).
.github/**
README.md
README.zh.md
CHANGELOG.md
CHANGELOG.zh.md
LICENSE_zh
.gitignore
TODO.md
CLAUDE.md
.learnings/**

# Reference / scratch directories that must not be shipped
deepseek-v4-for-copilot/**
minimax-status/**
Mini-Agent/**
oai-compatible-copilot/**
docs/**
test/**

# Local build artefacts
dist/**
out-test/**
**/*.vsix

# Bundle the SKILL files that ship with the extension (consumed at
# runtime by the dashboard's "Install Agent Skill" fallback). They
# live outside `src/` and are not in the deny list above, but we
# whitelist them explicitly here so future edits to this file can't
# accidentally drop them.
!skills/**